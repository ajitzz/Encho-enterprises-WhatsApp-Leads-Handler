{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "encho-whatsapp-lead-handler",
  "main": "src/worker.ts",
  "compatibility_date": "2026-04-16",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "ALLOWED_ORIGINS": "*",
    "BACKEND_API_ORIGIN": "https://encho-enterprises-whatsapp-leads-handler-q7ac.onrender.com"
  },
  "triggers": {
    "crons": [
      "*/4 * * * *"
    ]
  }
}
